[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[requires]
python_version = "3.13"

[packages]
numpy = ">=1.26"
pandas = ">=2.1"
scikit-learn = ">=1.4"
scipy = ">=1.11"
pyyaml = ">=6.0"
pyarrow = ">=15.0"
# xgboost 3.x is the first release with kernels for Blackwell (sm_120);
# registry.py requests device="cuda" for the xgb entry.
xgboost = ">=3.0"
# PyPI wheels are CPU-only: no OpenCL and no CUDA tree learner.
lightgbm = ">=4.3"

[dev-packages]
ipykernel = "*"

[scripts]
run = "python src/run.py --config config.yaml"
rerun = "python src/run.py --config config.yaml --overwrite"
gpucheck = "python tools/gpu_check.py"
